rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny: Firestore already denies any path with no matching allow.
    // This catch-all is documentation only (allow rules are OR-ed, so it can
    // never override a broader allow). List every collection explicitly below.
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() >= 1;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The stored email must be the address Firebase Auth holds for this token.
    function emailMatchesToken(data) {
      return request.auth.token.email != null
        && data.email == request.auth.token.email;
    }

    // Rules-expressible subset of lib/name-moderation.ts: 2-20 chars, letters
    // (any script), combining marks, digits, space - _ . ; no leading/trailing
    // space. Profanity/impersonation/PII checks cannot be expressed in rules
    // and live in the client and the submitScore function, which never trusts
    // the client for the name shown on the leaderboard.
    function isAcceptableDisplayName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 20
        && name.matches('^[\\p{L}\\p{N}][\\p{L}\\p{M}\\p{N} _.\\-]*$')
        && !name.matches('.*\\s$');
    }

    function isValidTier(tier) {
      return tier is string && tier in ['explorers', 'challengers', 'strategists'];
    }

    // -------------------------------------------------------------------------
    // Validation blueprints
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && isAcceptableDisplayName(data.displayName)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && emailMatchesToken(data)
        && isValidTier(data.ageTier)
        && data.dailyProblemGoal is int
        && data.dailyProblemGoal >= 5
        && data.dailyProblemGoal <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /users/{userId}: private, owner-only
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // /gameScores/{scoreId}: readable by any SIGNED-IN user, written ONLY by
    // the submitScore Cloud Function (Admin SDK bypasses these rules).
    // Doc id is {uid}_{gameId}_{serverDateKey}; the function keeps best-of-day.
    // Exposed fields: uid, displayName, tier, gameId, score, accuracy, dateKey.
    // This is NOT zero-PII (see security_spec.md). Erasure on account deletion
    // is done by the eraseUserData auth-trigger function, not by the client.
    // -------------------------------------------------------------------------
    match /gameScores/{scoreId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Server-only collections (round tokens, anomaly flags, rate-limit
    // counters). No client access of any kind.
    match /rounds/{roundId} {
      allow read, write: if false;
    }
    match /scoreFlags/{flagId} {
      allow read, write: if false;
    }
    match /rateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
