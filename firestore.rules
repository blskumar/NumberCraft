rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny: Firestore already denies any path with no matching allow.
    // This catch-all is documentation only (allow rules are OR-ed, so it can
    // never override a broader allow). List every collection explicitly below.
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() >= 1;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The stored email must be the address Firebase Auth holds for this token.
    function emailMatchesToken(data) {
      return request.auth.token.email != null
        && data.email == request.auth.token.email;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function dayKey(t) {
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    // dateKey is the player's LOCAL day, so accept server UTC day +/- 1.
    function isNearServerDay(key) {
      return key in [
        dayKey(request.time - duration.value(1, 'd')),
        dayKey(request.time),
        dayKey(request.time + duration.value(1, 'd'))
      ];
    }

    // The public name on a score must equal the owner's profile name.
    function profileName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;
    }

    function isValidTier(tier) {
      return tier is string && tier in ['explorers', 'challengers', 'strategists'];
    }

    function isValidGameId(gameId) {
      return gameId is string && gameId in [
        'addition-attack',
        'subtraction-sprint',
        'multiplication-mastery',
        'equation-foundry',
        'odds-urns',
        'factor-grid',
        'daily-challenge'
      ];
    }

    // Must match PLAYABLE_GAME_CATALOG titles in lib/guest-trial.ts.
    function gameTitles() {
      return {
        'addition-attack': 'Addition Attack',
        'subtraction-sprint': 'Subtraction Sprint',
        'multiplication-mastery': 'Multiplication Mastery',
        'equation-foundry': 'Equation Foundry',
        'odds-urns': 'Odds & Urns',
        'factor-grid': 'Factor Grid',
        'daily-challenge': 'Daily Math Challenge'
      };
    }

    // -------------------------------------------------------------------------
    // Validation blueprints
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 28
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && emailMatchesToken(data)
        && isValidTier(data.ageTier)
        && data.dailyProblemGoal is int
        && data.dailyProblemGoal >= 5
        && data.dailyProblemGoal <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGameScore(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'gameId',
          'gameTitle',
          'tier',
          'score',
          'accuracyPercent',
          'dateKey',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'gameId',
          'gameTitle',
          'tier',
          'score',
          'accuracyPercent',
          'dateKey',
          'createdAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 28
        && data.displayName == profileName()
        && isValidGameId(data.gameId)
        && data.gameTitle == gameTitles()[data.gameId]
        && isValidTier(data.tier)
        && data.score is int
        && data.score >= 0
        && data.score <= 100000
        && data.accuracyPercent is int
        && data.accuracyPercent >= 0
        && data.accuracyPercent <= 100
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isNearServerDay(data.dateKey)
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /users/{userId}: private, owner-only
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // /gameScores/{scoreId}: readable by any SIGNED-IN user.
    // Exposed fields: uid, displayName, tier, gameId, score, accuracy, dateKey.
    // This is NOT zero-PII (see security_spec.md).
    //
    // Doc id is deterministic ({uid}_{gameId}_{dateKey}): one doc per user,
    // game and day, so one account cannot flood the board. A score can only be
    // RAISED (best-of-day); createdAt is bumped to request.time on each raise.
    // Scores are still asserted by the client: genuine anti-cheat needs a
    // trusted backend (Cloud Function) which this project does not have.
    // -------------------------------------------------------------------------
    match /gameScores/{scoreId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && isEmailVerified()
        && isValidId(scoreId)
        && isValidGameScore(incoming())
        && scoreId == incoming().uid + '_' + incoming().gameId + '_' + incoming().dateKey
        && incoming().createdAt == request.time;

      allow update: if isSignedIn()
        && isEmailVerified()
        && existing().uid == request.auth.uid
        && isValidGameScore(incoming())
        && incoming().createdAt == request.time
        && incoming().score > existing().score
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'score',
          'accuracyPercent',
          'createdAt'
        ]);

      // Owner may erase their own scores (account deletion / right to erasure).
      allow delete: if isSignedIn()
        && isValidId(scoreId)
        && existing().uid == request.auth.uid;
    }
  }
}
