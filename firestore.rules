rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 3: Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() >= 1;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTier(tier) {
      return tier is string && tier in ['explorers', 'challengers', 'strategists'];
    }

    function isValidGameId(gameId) {
      return gameId is string && gameId in [
        'addition-attack',
        'subtraction-sprint',
        'multiplication-mastery',
        'equation-foundry',
        'odds-urns',
        'factor-grid',
        'daily-challenge'
      ];
    }

    // -------------------------------------------------------------------------
    // Pillar 2: Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 28
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && isValidTier(data.ageTier)
        && data.dailyProblemGoal is int
        && data.dailyProblemGoal >= 5
        && data.dailyProblemGoal <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGameScore(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'gameId',
          'gameTitle',
          'tier',
          'score',
          'accuracyPercent',
          'dateKey',
          'weekKey',
          'visibility',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'gameId',
          'gameTitle',
          'tier',
          'score',
          'accuracyPercent',
          'dateKey',
          'weekKey',
          'visibility',
          'createdAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 28
        && isValidGameId(data.gameId)
        && data.gameTitle is string
        && data.gameTitle.size() >= 1
        && data.gameTitle.size() <= 48
        && isValidTier(data.tier)
        && data.score is int
        && data.score >= 0
        && data.score <= 100000
        && data.accuracyPercent is int
        && data.accuracyPercent >= 0
        && data.accuracyPercent <= 100
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.weekKey is string
        && data.weekKey.size() == 8
        && data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && data.visibility is string
        && data.visibility == 'public'
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection: /users/{userId} (Strict Owner-Only PII Isolation)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'ageTier',
          'dailyProblemGoal',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // Collection: /gameScores/{scoreId} (Zero-PII Immutable Leaderboard Ledger)
    // -------------------------------------------------------------------------
    match /gameScores/{scoreId} {
      allow get: if isValidId(scoreId) && existing().visibility == 'public';
      allow list: if existing().visibility == 'public';

      allow create: if isSignedIn()
        && isValidId(scoreId)
        && isValidGameScore(incoming())
        && incoming().createdAt == request.time;

      // Scores are immutable once recorded (anti-tampering)
      allow update: if false;

      allow delete: if isSignedIn()
        && isValidId(scoreId)
        && existing().uid == request.auth.uid;
    }
  }
}
